{
  "name": "fancy-research-tools",
  "version": "0.1.0",
  "description": "A documented browser starter for research tools",
  "scripts": {
    "predev": "node scripts/build-docs.mjs && node scripts/build-gallery.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && biome check .",
    "check:data": "node scripts/check-data.mjs && node scripts/check-annotation-data.mjs && node data/hsa-letter/generate.mjs --check && node scripts/import-schoenbach-data.mjs --check",
    "format": "biome check --write .",
    "test": "vitest run",
    "prebuild": "node scripts/build-docs.mjs && node scripts/build-gallery.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "hooks:install": "simple-git-hooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalHumanitiesCraft/fancy-research-tools.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DigitalHumanitiesCraft/fancy-research-tools/issues"
  },
  "homepage": "https://github.com/DigitalHumanitiesCraft/fancy-research-tools#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "lint-staged": "^16.4.0",
    "marked": "^18.1.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true,
  "browserslist": [
    "baseline widely available"
  ],
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,css}": "biome check --write"
  }
}
