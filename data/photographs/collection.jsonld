    {
      "id": "https://clevelandart.org/art/1980.35",
      "@type": "Photograph",
      "title": "Rue du Regard",
      "date": {
        "label": "1899",
        "start": 1899,
        "end": 1899,
        "kind": "exact-year",
        "indexStart": 1899,
        "indexEnd": 1899
      },
      "creators": [
        {
          "name": "Eugène Atget (French, 1857–1927)",
          "id": "https://openaccess-api.clevelandart.org/api/creators/23",
          "role": "artist",
