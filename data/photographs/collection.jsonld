        "indexEnd": 1886
      },
      "creators": [
        {
          "name": "Peter Henry Emerson (British, 1856–1936)",
          "id": "https://openaccess-api.clevelandart.org/api/creators/110",
          "role": "artist",
          "qualifier": null,
          "extent": null
        },
        {
          "name": "Sampson Low, Marston, Seale and Riverton (with T.F. Goodall)",
